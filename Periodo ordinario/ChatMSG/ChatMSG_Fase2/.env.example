# Copia a .env en esta carpeta (ChatMSG_Fase2) y rellena valores.
#
# OBLIGATORIO: contraseña de Redis Cloud. Sin ella verás NOAUTH y el backend no arranca.
# Cópiala del panel (Database > tu DB > "Copy" en la URL o el campo de password).
#
# Opción A — URL completa (incluye usuario default y clave):
#   redis://default:TU_PASSWORD@redis-18104.c251.east-us-mz.azure.cloud.redislabs.com:18104
# Si el panel te da rediss:// (TLS), úsala tal cual en REDIS_URL.
REDIS_URL=

# Opción B — host + puerto (si no usas REDIS_URL):
REDIS_HOST=redis-18104.c251.east-us-mz.azure.cloud.redislabs.com
REDIS_PORT=18104
REDIS_PASSWORD=Ca4DwrGuldlXfhmfgRFb7CNr6jtQzpSH
# Usuario ACL en Redis 6+ (Redis Cloud casi siempre es "default"; ya está aplicado en código si hay REDIS_PASSWORD)
# REDIS_USERNAME=default
# REDIS_TLS=1

# Mismo canal en todos los servidores que deben compartir chat:
REDIS_CHANNEL=chatmsg:messages

# Secreto compartido entre instancias para firmar la cookie httpOnly (¡mismo valor en tu máquina y la de tu compañero si comparten sesión JWT… normalmente cada uno usa el suyo para sus usuarios locales).
JWT_SECRET=cambia-esto-en-produccion

# Identificador opcional de esta instancia (si no, se genera uno al arrancar):
# SERVER_ID=srv-mio

# Puerto del API (cliente Vite en dev proxifica a este puerto en vite.config.js)
PORT=3001

# Si levantas un segundo backend en el mismo PC, en client/.env (Fase 2) puedes poner:
# VITE_DEV_API_TARGET=http://localhost:3002
